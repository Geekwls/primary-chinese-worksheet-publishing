{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/schemas/primary-chinese-worksheet/document.schema.json",
  "title": "小学语文试卷文档契约",
  "description": "generated by primary-chinese-worksheet-publishing skill · spec 1.0.0",
  "type": "object",
  "required": ["document_id", "grade", "title", "sections"],
  "additionalProperties": true,
  "properties": {
    "document_id": { "type": "string", "minLength": 3 },
    "grade": { "type": "integer", "minimum": 1, "maximum": 6 },
    "doc_type": { "enum": ["practice", "review", "examination"] },
    "subject": { "enum": ["chinese", "math", "english"], "description": "学科标签（续页页眉用），缺省按语文处理" },
    "title": { "type": "string", "minLength": 4 },
    "time_limit": { "type": "string" },
    "total_score": { "type": "number" },
    "meta_fields": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "questions"],
        "properties": {
          "section_id": { "type": "string" },
          "title": { "type": "string" },
          "score": { "type": "number" },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/question" }
          }
        }
      }
    }
  },
  "definitions": {
    "blankText": {
      "type": "string",
      "description": "支持 {答案} 空槽语法"
    },
    "question": {
      "type": "object",
      "required": ["question_id", "type", "stem"],
      "properties": {
        "question_id": { "type": "string" },
        "type": { "enum": [
          "pinyin_write_word", "similar_character", "polyphonic", "add_pinyin", "idiom_fill",
          "word_pattern", "poem_fill", "sentence_rewrite", "reading",
          "composition", "generic", "choice", "judge", "stroke_order", "pinyin_match",
          "calculation", "fill_blank", "blank", "word_problem"
        ] },
        "stem": { "type": "string" },
        "score": { "type": "number" },
        "answer_text": { "type": "string", "description": "教师解析页标准答案，多条用 ／ 或 ； 分隔" },
        "explain": { "type": "string", "description": "教学解析/易错点" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "pinyin_write_word" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["pinyin", "answer"],
                "properties": {
                  "pinyin": { "type": "string", "description": "音节用空格分隔" },
                  "answer": { "type": "string" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "similar_character" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["chars", "answers"],
                "properties": {
                  "chars": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                  "answers": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "polyphonic" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["word", "answer"],
                "properties": {
                  "word": { "type": "string" },
                  "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                  "answer": { "type": "string" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "add_pinyin" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["word", "target", "answer"],
                "properties": {
                  "word": { "type": "string" },
                  "target": { "type": "integer", "minimum": 0 },
                  "answer": { "type": "string" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "idiom_fill" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["text"],
                "properties": { "text": { "$ref": "#/definitions/blankText" } }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "word_pattern" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["answers"],
                "properties": {
                  "label": { "type": "string" },
                  "samples": { "type": "array", "items": { "type": "string" } },
                  "answers": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "poem_fill" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["lines"],
                "properties": {
                  "title": { "type": "string" },
                  "lines": { "type": "array", "items": { "$ref": "#/definitions/blankText" }, "minItems": 1 }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "sentence_rewrite" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["sentence"],
                "properties": {
                  "sentence": { "type": "string" },
                  "kind": {
                    "enum": ["rewrite", "imitate"],
                    "description": "rewrite=改写原句；imitate=给例句仿写。缺省按 rewrite 处理，sentence 以「例：」开头时自动视为 imitate"
                  },
                  "require": { "type": "string" },
                  "answer": { "type": "string" },
                  "lines": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "reading" },
            "passage": {
              "type": "object",
              "required": ["paragraphs"],
              "properties": {
                "title": { "type": "string" },
                "paragraphs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            },
            "subs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stem"],
                "properties": {
                  "sub_type": { "enum": ["choice", "judge", "fill", "text"] },
                  "stem": { "$ref": "#/definitions/blankText" },
                  "options": { "type": "array", "items": { "type": "string" } },
                  "answer": { "type": "string" },
                  "lines": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "required": ["passage", "subs"]
        },
        {
          "properties": {
            "type": { "const": "composition" },
            "rows": { "type": "integer", "minimum": 2, "maximum": 14 },
            "prompt": { "type": "string" },
            "image": {
              "type": ["string", "object"],
              "properties": {
                "src": { "type": "string" },
                "height_mm": { "type": "number" },
                "caption": { "type": "string" }
              }
            }
          },
          "required": ["rows"]
        },
        {
          "properties": {
            "type": { "const": "generic" },
            "lines": { "type": "integer", "minimum": 0 },
            "answer": { "type": "string" }
          }
        },
        {
          "properties": {
            "type": { "const": "choice" },
            "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
            "answer": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stem", "options", "answer"],
                "properties": {
                  "stem": { "type": "string" },
                  "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                  "answer": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "judge" },
            "answer": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stem", "answer"],
                "properties": {
                  "stem": { "type": "string" },
                  "answer": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "stroke_order" },
            "word": { "type": "string" },
            "total_strokes": { "type": "integer" },
            "query": { "type": "string" },
            "answer": { "type": "string" },
            "order": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "word": { "type": "string" },
                  "total_strokes": { "type": "integer" },
                  "query": { "type": "string" },
                  "answer": { "type": "string" },
                  "order": { "type": "string" },
                  "text": { "$ref": "#/definitions/blankText" }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "pinyin_match" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["left", "right"],
                "properties": {
                  "left": { "type": "string" },
                  "right": { "type": "string" },
                  "match_index": { "type": "integer" }
                }
              }
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["left", "right"],
                "properties": {
                  "left": { "type": "string" },
                  "right": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "required": ["answer"],
          "properties": {
            "type": { "const": "calculation" },
            "answer": { "type": "string", "description": "计算结果；题干含 竖式/脱式/递等式 时渲染竖式作答区，否则渲染口算答题槽" }
          }
        },
        {
          "required": ["answer"],
          "properties": {
            "type": { "const": "fill_blank" },
            "answer": { "type": ["string", "array"], "items": { "type": "string" }, "description": "单个答案或按括号顺序排列的多答案数组" }
          }
        },
        {
          "required": ["answer"],
          "properties": {
            "type": { "const": "blank" },
            "answer": { "type": ["string", "array"], "items": { "type": "string" } }
          }
        },
        {
          "required": ["answer"],
          "properties": {
            "type": { "const": "word_problem" },
            "lines": { "type": "integer", "minimum": 3, "description": "作答书写行数，缺省 4" },
            "answer": { "type": "string" }
          }
        }
      ]
    }
  }
}
