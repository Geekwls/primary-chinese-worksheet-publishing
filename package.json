    "sample": "node scripts/build-standard-sample.mjs",
    "calibrate": "node scripts/generate-calibration.mjs",
    "diff": "node scripts/visual-diff.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
